# Use this file ONLY when the web server's document root is the project root (e.g. InfinityFree "htdocs").
# If you can point the document root at /public, delete this file.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never serve private folders or dotfiles
  RewriteRule ^(app|config|database|storage|tests|tools|bin)(/|$) - [F,L]
  RewriteRule (^|/)\.(env|git|htaccess) - [F,L]
  # Requests may arrive under a subfolder, so map them relative to this project
  # instead of building a path from DOCUMENT_ROOT.
  RewriteRule ^public/ - [L]
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "(^\.|\.(env|sql|md|log|bak|ini|lock|dist)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
