# Use this file ONLY when the web server's document root is the project root (e.g. InfinityFree "htdocs").
# If you can point the document root at /public, delete this file.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never serve private folders or dotfiles
  RewriteRule ^(app|config|database|storage|tests|tools|bin)(/|$) - [F,L]
  RewriteRule (^|/)\.(env|git|htaccess) - [F,L]
  # Serve real files from public/
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^(.*)$ public/$1 [L]
  # Everything else goes to the front controller
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^ public/index.php [L]
  RewriteRule ^public/index\.php$ - [L]
</IfModule>
<FilesMatch "(^\.|\.(env|sql|md|log|bak|ini|lock|dist)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
