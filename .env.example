# Copy to .env (never commit .env). All values are placeholders.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
# Set only if the site lives in a sub-folder, e.g. /daylight (no trailing slash). Empty for domain root.
APP_BASE_PATH=
APP_TIMEZONE=Africa/Nairobi
# Long random string (>= 32 chars); salts rate-limit hashes. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Turn on once HTTPS works on the host (adds redirect, HSTS, secure cookies)
APP_FORCE_HTTPS=false
# Only if behind a trusted proxy/CDN that sets X-Forwarded-* headers
TRUST_PROXY_HEADERS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional: where PHP session files go. Leave empty to use the host's default (recommended). If set, it must be writable and NOT inside the web root.
SESSION_PATH=
SESSION_NAME=daylight_session

# Email (SMTP). Leave MAIL_ENABLED=false until real credentials exist and delivery is tested.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS) | ssl | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Daylight
# Staff address that receives form notifications
MAIL_NOTIFY_TO=
# Require clients to confirm their email before first login (needs working SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# Website chat assistant. ASSISTANT_ENABLED=false hides the widget and disables the endpoint.
ASSISTANT_ENABLED=true
# AI mode (optional). Off by default: the assistant then answers from the site's own FAQs/content on your server, with no outside service.
# When ON, the visitor's question, recent messages and short extracts of public site content are sent to Anthropic (a transfer outside Kenya, disclosed in the privacy policy).
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Maximum AI replies per day across the whole site (cost control); the FAQ mode takes over after that
ASSISTANT_DAILY_AI_LIMIT=300
# Store chat text on the server (hashed session id, deleted after 90 days)? Off by default (data minimisation).
ASSISTANT_LOG_CHATS=false

# One-time web setup (/setup): set a long random token to enable, then REMOVE it after setup.
SETUP_TOKEN=
# Allow super admins to load dummy portal data from the admin area (testing only)
ALLOW_DEMO_DATA=false
