# Copy to .env (never commit .env). All values are placeholders.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
# Set only if the site lives in a sub-folder, e.g. /daylight (no trailing slash). Empty for domain root.
APP_BASE_PATH=
APP_TIMEZONE=Africa/Nairobi
# Long random string (>= 32 chars); salts rate-limit hashes. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Turn on once HTTPS works on the host (adds redirect, HSTS, secure cookies)
APP_FORCE_HTTPS=false
# Only if behind a trusted proxy/CDN that sets X-Forwarded-* headers
TRUST_PROXY_HEADERS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional: where PHP session files go (must be writable, and not web-accessible)
SESSION_PATH=
SESSION_NAME=daylight_session

# Email (SMTP). Leave MAIL_ENABLED=false until real credentials exist and delivery is tested.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS) | ssl | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Daylight
# Staff address that receives form notifications
MAIL_NOTIFY_TO=
# Require clients to confirm their email before first login (needs working SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# One-time web setup (/setup): set a long random token to enable, then REMOVE it after setup.
SETUP_TOKEN=
# Allow super admins to load dummy portal data from the admin area (testing only)
ALLOW_DEMO_DATA=false
